# ETLAB Integration Configuration
# Base domain of the institutional portal (default is TKM College of Engineering)
ETLAB_BASE_URL=https://tkmce.etlab.in

# Strong random secret key used for signing session cookies
SESSION_SECRET=replace-with-a-random-32-byte-secret-key

# Local server port
PORT=3000

# Administrative API Configuration
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ETPLUS@Admin2026
ADMIN_API_SECRET=replace-with-a-random-32-byte-secret-key

# Optional Supabase Integration (Leave empty to use shared local persistence)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
